# Base URL of the CodeNest REST API (Express). Required in production builds.
VITE_API_URL=http://localhost:5000/api

# Socket.io endpoint (presence / cursors). Required in production builds.
VITE_SOCKET_URL=http://localhost:5000

# y-websocket endpoint (CRDT collaboration). Required in production builds.
# Use wss:// in production when the API is served over HTTPS.
VITE_YJS_URL=ws://localhost:5000
